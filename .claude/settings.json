{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run check:i18n:*)",
      "Bash(npm run test:ci:*)",
      "Bash(npm run build:*)",
      "Bash(npx ng build:*)",
      "Bash(npx ng test:*)",
      "Bash(node scripts/check-i18n.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)"
    ],
    "ask": [
      "Bash(wrangler:*)",
      "Bash(npx wrangler:*)",
      "Bash(npm run d1:migrate:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
