# Local secrets for `npx wrangler pages dev`. Copy this file to `.dev.vars` (git-ignored).
# Production values live in the Cloudflare dashboard: Pages project → Settings → Variables and Secrets.

# Any long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Turnstile's always-pass test secret. On localhost the login widget uses the matching test
# site key automatically (login.component.ts). scripts/seed-local.mjs writes this file for you.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Only needed to test image uploads from the Dashboard (ImageKit → Developer → API keys).
IMAGEKIT_PRIVATE_KEY=
