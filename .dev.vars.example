# Local secrets for `npx wrangler pages dev`. Copy this file to `.dev.vars` (git-ignored).
# Production values live in the Cloudflare dashboard: Pages project → Settings → Variables and Secrets.

# Any long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Turnstile's always-pass test secret. Pair it with the test site key 1x00000000000000000000AA
# in login.component.ts while testing locally (ROADMAP DX-4) — don't commit that swap.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Only needed to test image uploads from the Dashboard (ImageKit → Developer → API keys).
IMAGEKIT_PRIVATE_KEY=
